{{- /* Nginx redirects:

- Get all pages with aliases. The home page also gets the old /index.php.
- Generate nginx redirects map for each alias.
- Resolve targets like site links do, so pages with a `redirect` param point to its target.
- Match languages by normalized lang name without locale, e.g. es_CO -> es, zh_TW -> zh.

  /old, /old/, and /old.php -> /new/ (skipped when /old is /new itself)
  /old.php?lang=<lang> -> translated /<lang>/new/ or default /new/ page if translation missing
  /?lang=<lang> -> translated home page

- The output is parsed as nginx config, so every line is checked against a safe character set.
*/ -}}


{{- if site.IsDefault -}}

  {{- $redirects := dict -}}
  {{- $safe_source := `^/[A-Za-z0-9._~/%-]*(\?lang=[A-Za-z_]+)?$` -}}
  {{- $safe_target := `^(/|https://)[A-Za-z0-9._~/%:?&=+()-]*$` -}}
  {{- $old_locales := slice
    "be"
    "ca"
    "cs"
    "de"
    "el"
    "en"
    "es"
    "es_CO"
    "eu"
    "fa"
    "fi"
    "fr"
    "ga"
    "hr"
    "hu"
    "it"
    "ja"
    "ka"
    "ko"
    "lo"
    "nl"
    "pl"
    "pt_BR"
    "ru"
    "sl"
    "sr"
    "sv"
    "ta"
    "tr"
    "uk"
    "zh_CN"
    "zh_TW"
  -}}

  {{- range $new_page := hugo.Sites.Default.Pages -}}
    {{- $aliases := $new_page.Aliases -}}
    {{- if $new_page.IsHome -}}
      {{- $aliases = $aliases | append "/index" -}}
    {{- end -}}

    {{- if $aliases -}}
      {{- $new_default := partial "utils/link_redirect.html" $new_page -}}
      {{- $new_langs := dict -}}

      {{- range $translation := $new_page.Translations -}}
        {{- $normalized := replace (lower $translation.Language.Name) "_" "-" -}}
        {{- $lang_name := index (split $normalized "-") 0 -}}
        {{- if not (isset $new_langs $lang_name) -}}
          {{- $new_langs = merge $new_langs (dict $lang_name (partial "utils/link_redirect.html" $translation)) -}}
        {{- end -}}
      {{- end -}}

      {{- range $alias := $aliases -}}
        {{- $alias = trim $alias "/" -}}
        {{- $php_alias := printf "/%s.php" $alias -}}
        {{- range $old_source := slice (printf "/%s" $alias) (printf "/%s/" $alias) $php_alias -}}
          {{- /* Skip /new and /new/, which would redirect to themselves. */ -}}
          {{- if ne (trim $old_source "/") (trim $new_default "/") -}}
            {{- $redirects = merge $redirects (dict $old_source $new_default) -}}
          {{- end -}}
        {{- end -}}

        {{- $lang_sources := slice $php_alias -}}
        {{- if $new_page.IsHome -}}
          {{- $lang_sources = $lang_sources | append "/" -}}
        {{- end -}}

        {{- range $old_locale := $old_locales -}}
          {{- $normalized := replace (lower $old_locale) "_" "-" -}}
          {{- $lang_name := index (split $normalized "-") 0 -}}
          {{- $new_target := default $new_default (index $new_langs $lang_name) -}}
          {{- range $lang_source := $lang_sources -}}
            {{- $redirects = merge $redirects (dict (printf "%s?lang=%s" $lang_source $old_locale) $new_target) -}}
          {{- end -}}
        {{- end -}}
      {{- end -}}
    {{- end -}}
  {{- end -}}

  {{- range $old, $new := $redirects -}}
    {{- if not (findRE $safe_source $old) -}}
      {{- errorf "Redirect source %q contains characters not allowed in the nginx map" $old -}}
    {{- end -}}
    {{- if not (findRE $safe_target $new) -}}
      {{- errorf "Redirect target %q for %q contains characters not allowed in the nginx map" $new $old -}}
    {{- end -}}
    {{- printf "%s %s;\n" $old $new -}}
  {{- end -}}
{{- end -}}
